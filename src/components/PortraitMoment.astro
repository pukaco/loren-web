---
import PortraitFigure from './PortraitFigure.astro';
---

<section class="moment" aria-label="About Loren, a preview">
  <div class="wrap">
    <div class="frame">
      <PortraitFigure
        ratio="16:9"
        variant={2}
        alt="Editorial portrait of Loren Muse — photography pending"
      />
      <span class="frame-rule" aria-hidden="true"></span>
    </div>

    <div class="grid">
      <p class="ghost-line" aria-hidden="true">Apparently</p>
      <div class="copy">
        <span class="eyebrow eyebrow--brass">Notes on Loren</span>
        <p class="prose">
          Loren Muse is a virtual influencer, digital personality and author
          fascinated by the strange relationship between people and the
          identities they encounter online.
        </p>
        <a class="text-link" href="/about">About Loren</a>
      </div>
    </div>
  </div>
</section>

<style>
  .moment {
    padding-block: var(--space-8);
  }

  .frame {
    position: relative;
    margin-bottom: var(--space-6);
  }

  .frame-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--brass) 0%, transparent 70%);
    opacity: 0.55;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
  }

  .ghost-line {
    grid-area: 1 / 1;
    margin: 0;
    align-self: start;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.5rem, 2.5rem + 8vw, 12rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--brass);
    opacity: 0.07;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .copy {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: 46ch;
    margin-top: clamp(2.5rem, 1rem + 6vw, 6rem);
  }

  .copy p {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
  }

  @media (max-width: 640px) {
    .ghost-line {
      font-size: clamp(3rem, 2rem + 14vw, 6rem);
    }

    .copy {
      margin-top: clamp(2rem, 1rem + 6vw, 3.5rem);
    }
  }
</style>
