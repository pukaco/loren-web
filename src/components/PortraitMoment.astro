---
import PortraitFigure from './PortraitFigure.astro';
---

<section class="moment" aria-label="About Loren, a preview">
  <div class="wrap grid">
    <div class="copy">
      <p class="prose">
        Loren Muse is a virtual influencer, digital personality and author
        fascinated by the strange relationship between people and the
        identities they encounter online.
      </p>
      <a class="text-link" href="/about">About Loren</a>
    </div>
    <PortraitFigure
      ratio="4:5"
      variant={2}
      alt="Editorial portrait of Loren Muse — photography pending"
      caption="Portrait — photography pending"
    />
  </div>
</section>

<style>
  .moment {
    padding-block: var(--space-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: var(--space-6);
  }

  .grid > * {
    min-width: 0;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 40ch;
  }

  .copy p {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .copy {
      order: 2;
      max-width: none;
    }
  }
</style>
