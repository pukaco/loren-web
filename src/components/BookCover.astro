---
import { Image } from 'astro:assets';
import cover from '../assets/book-cover.png';

interface Props {
  size?: 'compact' | 'full';
  priority?: boolean;
}

const { size = 'full', priority = false } = Astro.props;
---

<figure class={`cover cover--${size}`}>
  <Image
    src={cover}
    alt="Cover of She Lived Here, Apparently by Loren Muse"
    widths={[260, 380, 480, 760]}
    sizes={size === 'compact' ? '(max-width: 720px) 170px, 230px' : '(max-width: 760px) 260px, 380px'}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="cover-img"
  />
</figure>

<style>
  .cover {
    margin: 0;
    background: var(--paper);
    box-shadow: 0 1px 0 var(--hairline), 0 12px 28px -18px rgba(43, 38, 34, 0.35);
  }

  .cover-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .cover--compact {
    width: 100%;
  }
</style>
