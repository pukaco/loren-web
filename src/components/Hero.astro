---
import PortraitFigure from './PortraitFigure.astro';
---

<section class="hero">
  <div class="wrap grid">
    <PortraitFigure
      ratio="4:5"
      variant={1}
      priority={true}
      alt="Portrait of Loren Muse — photography pending"
      caption="Portrait — photography pending"
    />
    <div class="copy">
      <h1>Loren Muse</h1>
      <p class="lede">Author. Digital personality. Interested in reality, apparently.</p>
      <a class="text-link" href="/about">Meet Loren</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--space-6);
    padding-block-end: var(--space-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-6);
  }

  /* grid items default to min-width:auto (content's max-content width),
     which forces overflow instead of shrinking to the track — override it. */
  .grid > * {
    min-width: 0;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero h1 {
    font-size: var(--text-hero);
    font-style: italic;
    font-weight: 500;
    color: var(--brass);
    letter-spacing: -0.005em;
  }

  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--ink);
    max-width: 32ch;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
