---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INSTAGRAM_URL, CONTACT_EMAIL } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Contact Loren Muse for publishing, media and other enquiries."
>
  <section class="contact-page">
    <div class="wrap inner">
      <h1>Contact</h1>
      <p class="lede">For publishing, media and other enquiries:</p>
      <a class="text-link email-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <a class="text-link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        Instagram<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-block: var(--space-8) var(--space-9);
  }

  .inner {
    max-width: 46ch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .contact-page h1 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-1);
  }

  .lede {
    font-size: 1.0625rem;
  }

  .email-link {
    font-size: 1.0625rem;
    margin-bottom: var(--space-2);
  }
</style>
