---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCover from '../components/BookCover.astro';
import { BOOK_JSON_LD, AMAZON_URL } from '../lib/site';
---

<BaseLayout
  title="She Lived Here, Apparently"
  description="She Lived Here, Apparently — a contemporary humorous novel by Loren Muse, 2026."
  jsonLd={[BOOK_JSON_LD]}
>
  <section class="book-page">
    <p class="ghost-word" aria-hidden="true">Apparently</p>

    <div class="wrap grid">
      <div class="cover">
        <BookCover size="full" priority={true} />
      </div>
      <div class="copy">
        <p class="meta-line">Contemporary humorous fiction &middot; 2026</p>
        <h1>She Lived Here, Apparently</h1>
        <p class="meta-line">A novel by Loren Muse</p>

        <p class="hook">She invented the perfect tenant. Then everyone started treating her as real.</p>

        <div class="description">
          <p>
            Nina works in London lettings, where budgets stretch, commutes
            shrink and basements somehow acquire excellent natural light. So
            when she uses a few AI-generated images to invent Sienna, a
            fictional tenant who appears to live in one of the flats she
            markets, it feels like a harmless experiment.
          </p>
          <p>Then people start following her.</p>
          <p>
            They ask where she shops. They worry about her plans. They
            remember details Nina invented. Soon Sienna is being discussed at
            Nina&rsquo;s office too.
          </p>
          <p>
            And the more people expect from Sienna, the harder it becomes for
            Nina to keep an imaginary woman from complicating her very real
            life.
          </p>
        </div>

        {AMAZON_URL ? (
          <a class="amazon-button" href={AMAZON_URL} target="_blank" rel="noopener noreferrer">
            Buy on Amazon
          </a>
        ) : (
          <button type="button" class="amazon-button" disabled aria-disabled="true">
            Buy on Amazon
            <span class="status">Coming soon</span>
          </button>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-page {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-8);
  }

  .ghost-word {
    position: absolute;
    inset: 0;
    margin: 0;
    top: -0.1em;
    right: -0.06em;
    left: auto;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 22vw;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--brass);
    opacity: 0.06;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    text-align: right;
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 420px) 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .grid > * {
    min-width: 0;
  }

  .cover {
    width: 100%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .meta-line {
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-page h1 {
    font-size: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    font-style: italic;
    color: var(--ink);
    margin-block: var(--space-1);
  }

  .hook {
    margin-top: var(--space-3);
    max-width: 44ch;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.375rem, 1.15rem + 1.2vw, 1.875rem);
    line-height: 1.3;
    color: var(--brass);
    padding-left: var(--space-3);
    border-left: 2px solid var(--brass);
  }

  .description {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .amazon-button {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: 0.85rem 1.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    background: transparent;
    color: var(--ink-muted);
    border: 1px solid var(--hairline);
    cursor: not-allowed;
  }

  a.amazon-button {
    color: var(--ink);
    border-color: var(--brass);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  a.amazon-button:hover,
  a.amazon-button:focus-visible {
    background: var(--brass);
    color: var(--ivory);
  }

  .amazon-button .status {
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  @media (prefers-reduced-motion: reduce) {
    a.amazon-button {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .ghost-word {
      font-size: 42vw;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .cover {
      max-width: 260px;
    }

    .hook {
      padding-left: var(--space-2);
    }
  }
</style>
