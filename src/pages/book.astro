---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCover from '../components/BookCover.astro';
import { BOOK_JSON_LD } from '../lib/site';
---

<BaseLayout
  title="She Lived Here, Apparently"
  description="She Lived Here, Apparently — a contemporary humorous novel by Loren Muse, 2026."
  jsonLd={[BOOK_JSON_LD]}
>
  <section class="book-page">
    <div class="wrap grid">
      <div class="cover">
        <BookCover size="full" priority={true} />
      </div>
      <div class="copy">
        <p class="meta-line">Contemporary humorous fiction &middot; 2026</p>
        <h1>She Lived Here, Apparently</h1>
        <p class="meta-line">A novel by Loren Muse</p>

        <p class="blurb" data-temporary-copy="true">
          <em>Official blurb pending.</em> This space is reserved for the
          book&rsquo;s final back-cover copy — one short paragraph, no
          reviews, no endorsements.
        </p>

        <button type="button" class="amazon-button" disabled aria-disabled="true">
          Buy on Amazon
          <span class="status">Coming soon</span>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-page {
    padding-block: var(--space-6) var(--space-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .grid > * {
    min-width: 0;
  }

  .cover {
    max-width: 380px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .meta-line {
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .book-page h1 {
    font-size: var(--text-h1);
    font-style: italic;
    margin-block: var(--space-1);
  }

  .blurb {
    margin-top: var(--space-3);
    max-width: 52ch;
    font-size: 1.0625rem;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .blurb em {
    color: var(--ink);
    font-style: normal;
    font-weight: 500;
  }

  .amazon-button {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: 0.85rem 1.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--ink-muted);
    border: 1px solid var(--hairline);
    cursor: not-allowed;
  }

  .amazon-button .status {
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-muted);
    font-size: var(--text-caption);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .cover {
      max-width: 260px;
    }
  }
</style>
